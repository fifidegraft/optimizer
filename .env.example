# ====================================================================
# Optimizer Configuration
# ====================================================================
# The Optimization Agent is designed to be ZERO-COST and OFFLINE-READY by default.
# If no keys are set, Optimizer runs in Mock Mode (generating built-in candidate strategies).

# Choose your provider: 'mock', 'anthropic', 'gemini', 'ollama', 'groq', or 'openai'
# If left empty, Optimizer auto-detects based on available keys below.
LLM_PROVIDER=mock

# --------------------------------------------------------------------
# 1. Anthropic
# --------------------------------------------------------------------
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-opus-5

# --------------------------------------------------------------------
# 2. Google Gemini (FREE TIER AVAILABLE)
# --------------------------------------------------------------------
# Get a free API key at: https://aistudio.google.com/
# Free tier supports up to 15 requests per minute with no credit card.
# GEMINI_API_KEY=your_google_ai_studio_key_here
# GEMINI_MODEL=gemini-3.6-flash

# --------------------------------------------------------------------
# 3. Local Ollama (100% FREE & OFFLINE)
# --------------------------------------------------------------------
# Install Ollama from https://ollama.com and run:
#   ollama run qwen2.5-coder
# OLLAMA_HOST=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder

# --------------------------------------------------------------------
# 4. Groq (FREE TIER AVAILABLE)
# --------------------------------------------------------------------
# Free fast inference on open models at https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --------------------------------------------------------------------
# 5. OpenAI (Paid)
# --------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
